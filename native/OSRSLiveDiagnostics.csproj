<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.7.3</Version>
    <AssemblyName>OSRS-Play</AssemblyName>
    <ApplicationTitle>OSRS Play</ApplicationTitle>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CI overrides these three values. Local builds stay explicit. -->
    <OsrsBuildRun Condition="'$(OsrsBuildRun)' == ''">local</OsrsBuildRun>
    <OsrsBuildSha Condition="'$(OsrsBuildSha)' == ''">unknown</OsrsBuildSha>
    <OsrsBuildChannel Condition="'$(OsrsBuildChannel)' == ''">local</OsrsBuildChannel>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OsrsBuildRun</_Parameter1>
      <_Parameter2>$(OsrsBuildRun)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OsrsBuildSha</_Parameter1>
      <_Parameter2>$(OsrsBuildSha)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OsrsBuildChannel</_Parameter1>
      <_Parameter2>$(OsrsBuildChannel)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="OpenCvSharp4.Windows.Slim" Version="4.13.0.20260627" />
    <EmbeddedResource Include="Licenses/*.txt" />
    <EmbeddedResource Include="MinimapAssets/*.png" />
  </ItemGroup>
</Project>
